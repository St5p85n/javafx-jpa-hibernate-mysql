         <Label layoutX="129.0" layoutY="61.0" text="Email" textFill="#e4dddd">
            <font>
               <Font size="20.0" />
            </font>
         </Label>
         <Label layoutX="129.0" layoutY="111.0" text="Pass" textFill="#e4dddd">
